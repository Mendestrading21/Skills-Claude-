# Névé — variables d'environnement
#
# L'application fonctionne entièrement en mode local : AUCUN secret n'est
# nécessaire pour la lancer. Ce fichier documente uniquement les variables
# OPTIONNELLES pour de futures intégrations distantes (désactivées par défaut).
#
# Ne committez jamais de clés réelles. Copiez ce fichier en `.env.local`.

# Fournisseur de prix de marché (optionnel, non requis en mode local)
# EXPO_PUBLIC_PRICES_PROVIDER=
# PRICES_API_KEY=

# Fournisseur de taux de change (optionnel)
# EXPO_PUBLIC_FX_PROVIDER=
# FX_API_KEY=

# Assistant distant (optionnel — désactivé tant que non consenti dans les réglages)
# ASSISTANT_API_KEY=
